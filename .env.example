# Django
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Supabase Postgres)
# Option A (recommended): single URL
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
POSTGRES_SSLMODE=require

# Option B (without DATABASE_URL)
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Product pricing
CUT_PRICE_CENTS=1000
SIGNED_URL_EXPIRATION_SECONDS=604800

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_URL=http://localhost:8000/payments/webhook/mercadopago/
MERCADOPAGO_APP_BASE_URL=http://localhost:8000

# Email (dev fallback uses console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@autocut.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
